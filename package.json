{
  "name": "wordle-royale",
  "version": "0.0.0",
  "private": true,
  "description": "Wordle Royale pnpm monorepo workspace.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "typecheck": "pnpm validate:workspace",
    "lint": "pnpm validate:workspace",
    "test": "pnpm validate:workspace",
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @wordle-royale/web dev",
    "dev:api": "pnpm --filter @wordle-royale/api dev",
    "dev:mobile": "pnpm --filter @wordle-royale/mobile dev",
    "deps:up": "node scripts/docker-compose.mjs up -d postgres redis",
    "deps:check": "node scripts/check-local-deps.mjs --check",
    "deps:verify": "node scripts/check-local-deps.mjs --verify",
    "deps:down": "node scripts/docker-compose.mjs down",
    "deps:reset": "node scripts/docker-compose.mjs down --volumes --remove-orphans",
    "ranked:smoke:reset": "node scripts/reset-ranked-smoke-db.mjs",
    "ranked:smoke:bootstrap": "node scripts/ranked-smoke-bootstrap.mjs",
    "ranked:demo:e2e": "node scripts/ranked-demo-e2e.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:api:prod-start": "node scripts/api-prod-start-smoke.mjs",
    "smoke:speed:hosted": "node scripts/hosted-speed-smoke.mjs",
    "test:smoke:speed:hosted": "node --test scripts/hosted-speed-smoke.test.mjs",
    "test:auth:activation-tooling": "node --test scripts/auth-activation-tooling.test.mjs",
    "test:provider-provenance": "node --test scripts/provider-provenance.test.mjs scripts/provider-provenance-live.test.mjs scripts/provider-provenance-live-collector.test.mjs scripts/provider-provenance-live-cli.e2e.test.mjs",
    "test:provider-provenance:fixture-v2": "node --test scripts/provider-provenance.test.mjs",
    "test:provider-provenance:live-v3": "node --test scripts/provider-provenance-live.test.mjs",
    "test:provider-provenance:live-collector": "node --test scripts/provider-provenance-live-collector.test.mjs",
    "test:provider-provenance:live-cli-e2e": "node --test scripts/provider-provenance-live-cli.e2e.test.mjs",
    "g0:qualify": "node scripts/g0-qualification.mjs",
    "test:g0:qualification": "node --test scripts/g0-qualification.test.mjs scripts/g0-qualification-cli.e2e.test.mjs",
    "typecheck:g0:qualification": "node --check scripts/g0-qualification-core.mjs && node --check scripts/g0-qualification.mjs && node --check scripts/g0-qualification.test.mjs && node --check scripts/g0-qualification-cli.e2e.test.mjs",
    "typecheck:provider-provenance": "node --check scripts/provider-provenance-core.mjs && node --check scripts/provider-provenance-live-core.mjs && node --check scripts/provider-provenance-live-collector-core.mjs && node --check scripts/provider-provenance-live.mjs && node --check scripts/provider-provenance.mjs && node --check scripts/provider-provenance-fixture.mjs && node --check scripts/provider-provenance.test.mjs && node --check scripts/provider-provenance-live.test.mjs && node --check scripts/provider-provenance-live-collector.test.mjs && node --check scripts/provider-provenance-live-cli.e2e.test.mjs && node --check apps/api/scripts/run-auth-activation-preflight-live-v3-cli-e2e.mjs",
    "provider-provenance": "node scripts/provider-provenance.mjs",
    "provider-provenance:live": "node scripts/provider-provenance-live.mjs",
    "test:postgres:auth-activation-smoke": "pnpm --filter @wordle-royale/api test:postgres:auth-activation-smoke",
    "test:postgres:preflight-fingerprint": "pnpm --filter @wordle-royale/api test:postgres:preflight-fingerprint",
    "test:postgres:auth-preflight-cli-e2e": "pnpm --filter @wordle-royale/api test:postgres:auth-preflight-cli-e2e",
    "test:auth-preflight-live-v3-cli-e2e": "pnpm --filter @wordle-royale/api test:auth-preflight-live-v3-cli-e2e",
    "secret-scan": "node scripts/secret-scan.mjs",
    "word:fixture:build": "pnpm --filter @wordle-royale/word-tools word:fixture:build",
    "rating:simulate": "pnpm --filter @wordle-royale/rating-tools rating:simulate"
  }
}
