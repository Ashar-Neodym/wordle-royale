{
  "name": "@wordle-royale/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js web app shell for Wordle Royale.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "test": "node scripts/run-tests.mjs",
    "test:challenge": "node --test src/lib/challenge-id.test.ts src/lib/challenge-persistence.test.ts src/components/challenge-surface.test.ts",
    "test:challenge:id": "node --test src/lib/challenge-id.test.ts",
    "test:challenge:persistence": "node --test src/lib/challenge-persistence.test.ts",
    "test:actions": "node --test src/lib/server-action-presentation.test.ts",
    "test:routing": "node --test src/lib/restricted-route-presentation.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "next build"
  },
  "dependencies": {
    "@wordle-royale/contracts": "workspace:*",
    "@wordle-royale/design-tokens": "workspace:*",
    "@wordle-royale/fixtures": "workspace:*",
    "@wordle-royale/game-engine": "workspace:*",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
