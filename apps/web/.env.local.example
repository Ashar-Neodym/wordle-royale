# One credential-free root API origin for the Next.js server reads.
# Hosted deployments should set API_BASE_URL at runtime. NEXT_PUBLIC_API_URL remains
# a compatibility input; when both are set they must resolve to the same origin.
API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Durable account UI fails closed unless these mirror an enabled API deployment.
# Keep false for the current preview/demo deployment.
DURABLE_AUTH_ENABLED=false
PUBLIC_WEB_URL=http://localhost:3000
