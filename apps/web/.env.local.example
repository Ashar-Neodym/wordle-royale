# Credential-free root origins used only by server reads and the durable BFF.
# When both API origins are set they must resolve to the same exact origin.
API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
PUBLIC_WEB_URL=http://localhost:3000

# Public, non-secret presentation aliases embedded for Next build/prerender.
WORDLE_WEB_ENV=preview
WORDLE_ACCOUNT_MODE=preview_demo

# The current deployed preview remains compatible when all WORDLE aliases are
# absent and the existing durable server gate is exactly false. New production
# builds must explicitly select one of:
#   dormant: WORDLE_WEB_ENV=production, WORDLE_ACCOUNT_MODE=disabled,
#            durable server gate false (no WORDLE_REGISTRATION_MODE)
#   durable: WORDLE_WEB_ENV=production, WORDLE_ACCOUNT_MODE=durable,
#            durable server gate true, WORDLE_REGISTRATION_MODE=closed|canary|open
#
# Durable production additionally requires exact HTTPS PUBLIC_WEB_URL and API
# origins at runtime. The neutral aliases contain presentation only. Never put
# cookies, credentials, canary digests, or rate-limit secrets in Next config.
